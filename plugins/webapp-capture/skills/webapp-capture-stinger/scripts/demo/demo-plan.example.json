{
  "title": "Book your first job",
  "summary": "A 60 to 90 second walkthrough for new users: from the schedule you land on after signing in to a booked, assigned appointment.",
  "audience": "New users evaluating the product",
  "approved": false,
  "video": {
    "width": 1920,
    "height": 1080,
    "cursor": true,
    "parkAt": { "x": 1880, "y": 1040 },
    "endHoldMs": 1500
  },
  "narration": {
    "wordsPerMinute": 140,
    "tts": { "style": "warm", "voice": null, "model": null }
  },
  "safety": {
    "$comment": "Clicks and typing on targets whose real text matches the built-in deny list abort the recording. denyPattern only adds to that list. Credential fields are always refused. The plan, and every entry in writes[], must be approved by a human before recording.",
    "denyPattern": "(archive|cancel subscription)"
  },
  "writes": [
    {
      "id": "book-tuesday-slot",
      "scene": "book",
      "description": "Creates one non-recurring Lawn care appointment in the first free Tuesday morning slot and assigns Sam to it.",
      "effect": "The Tuesday column shows one Lawn care card assigned to Sam, and nothing repeats on later weeks.",
      "approved": false
    }
  ],
  "scenes": [
    {
      "id": "hook",
      "title": "Your week at a glance",
      "route": "/schedule",
      "narration": "Here is the schedule you land on after signing in. [short pause] Every job and every crew member, in one place.",
      "actions": [
        { "type": "waitFor", "selector": "[data-testid=calendar-grid]" },
        { "type": "scrollElement", "selector": "[data-testid=calendar-grid]", "intoView": "[data-time='08:00']", "block": "start" },
        { "type": "wait", "ms": 800, "screenshot": "schedule-overview" }
      ],
      "verify": [
        { "type": "visible", "selector": "[data-testid=calendar-grid]" }
      ]
    },
    {
      "id": "book",
      "title": "Book a job in a free slot",
      "route": "/schedule",
      "narration": "Drag a service onto a free slot, pick the details, and confirm. [pause] Then drop a crew member on the job to assign it.",
      "actions": [
        { "type": "waitFor", "selector": "[data-day=tue] [data-slot][data-free=true]" },
        { "type": "scrollElement", "selector": "[data-testid=calendar-grid]", "intoView": "[data-day=tue] [data-slot][data-free=true]" },
        { "type": "drag", "from": "[data-testid=service-palette] [data-service='lawn-care']", "to": "[data-day=tue] [data-slot][data-free=true]", "steps": 30 },
        { "type": "select", "selector": "select[name=service]", "label": "Lawn care" },
        { "type": "uncheck", "selector": "input[name=repeats]" },
        { "type": "click", "selector": "button[type=submit]" },
        { "type": "confirmDialog", "expect": "Book Lawn care on Tuesday", "button": "Book appointment" },
        { "type": "waitFor", "text": "Lawn care" },
        { "type": "dragTo", "selector": "[data-testid=crew] [data-member='sam']", "target": "[data-day=tue] [data-appointment]:has-text('Lawn care')" },
        { "type": "wait", "ms": 1200, "screenshot": "booked-and-assigned" }
      ],
      "verify": [
        { "type": "count", "selector": "[data-day=tue] [data-appointment]:has-text('Lawn care')", "equals": 1 },
        { "type": "text", "selector": "[data-day=tue] [data-appointment]:has-text('Lawn care')", "expect": "Sam" },
        { "type": "hidden", "selector": "[data-appointment] [data-recurring=true]" }
      ]
    }
  ]
}
